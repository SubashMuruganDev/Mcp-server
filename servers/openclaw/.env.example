# =============================================================================
# OpenClaw MCP Server Configuration
# =============================================================================

# Port for the MCP HTTP server to listen on
PORT=3000

# Host to bind to.
# Use 127.0.0.1 (default) when behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel).
# Set to 0.0.0.0 only if you are handling TLS/auth at network level yourself.
BIND_HOST=127.0.0.1

# Secret token that Claude uses to authenticate to THIS MCP server.
# Generate a strong token: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-strong-random-secret

# =============================================================================
# OpenClaw API Connection
# =============================================================================

# Base URL of the OpenClaw gateway (default port is 18789)
OPENCLAW_BASE_URL=http://localhost:18789

# Bearer token for authenticating to OpenClaw.
# Set this with: openclaw config set gateway.token your-secret-token
OPENCLAW_TOKEN=replace-with-your-openclaw-token

# =============================================================================
# Security (optional)
# =============================================================================

# Comma-separated list of allowed CORS origins.
# Requests from browser origins not in this list will be rejected (403).
# Direct API calls (e.g. from Claude) do not send Origin headers and are always allowed.
ALLOWED_ORIGINS=https://claude.ai,https://anthropic.com
